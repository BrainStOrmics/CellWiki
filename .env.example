# Agentic CellWiki local configuration.
# Copy this file to `.env` and keep the real `.env` out of Git.

# Required: API key for the OpenAI-compatible model provider used by WikiAgent.
OPENAI_API_KEY=

# Optional: provider's OpenAI-compatible base URL.
# Leave empty when the provider SDK's default endpoint should be used.
OPENAI_BASE_URL=

# Model name exposed by the configured provider.
OPENAI_MODEL=qwen3.6-plus

# OpenAI wire protocol: chat_completions or responses.
# Most third-party compatible endpoints implement chat_completions only.
OPENAI_API_PROTOCOL=chat_completions

# Per-request timeout in seconds. Run-level budgets remain independently enforced.
OPENAI_REQUEST_TIMEOUT_SECONDS=90

# Ingest requests use one total attempt budget and at most this many concurrent chunks.
INGEST_CHUNK_TIMEOUT_SECONDS=210
INGEST_MAX_ATTEMPTS=3
INGEST_MAX_CONCURRENCY=1
INGEST_MAX_OUTPUT_TOKENS=5000

# Application log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Desktop interface language: zh-CN or en.
APP_LANGUAGE=zh-CN

# Experimental Agent capabilities. Keep disabled until the bundled evaluation
# shows a groundedness/recall gain for the configured model and corpus.
ENABLE_AGENT_MEMORY=false
ENABLE_EXTERNAL_RESEARCH=false
MEMORY_RECALL_TOKEN_BUDGET=800

# Generated wiki. The pattern matches any depth, so the frontend Wiki feature
# directory has to be re-included or its source files silently stay untracked.
wiki/
!frontend/src/features/wiki/
# The evaluation fixture is a knowledge base on purpose: its wiki/ and raw/
# content must be versioned even though both patterns match at any depth.
!evals/agent/workspace/wiki/
!evals/agent/workspace/raw/

# Runtime data (can be regenerated)
data/extraction/
data/runtime/
data/sources/
# data/references/

